# Copy this file to .env before running the server.

# SQLite for local dev/testing. When moving to the company server, point
# this at SQL Server / Postgres instead (and change the `provider` in
# prisma/schema.prisma to match) — no other code changes needed.
DATABASE_URL="file:./dev.db"

# Change this to a long random string before any real deployment.
JWT_SECRET="dev-only-change-me-before-hosting"

PORT=4000

# Comma-separated list of frontend origins allowed to call the API in dev
# (the Vite dev server). Not needed in production since the server serves
# the built client itself.
CLIENT_ORIGIN="http://localhost:5173"

# Email intake (Gmail API) — see README.md's "Email intake (Gmail)" section
# for the one-time Google Cloud setup. Leave these blank to run without the
# email feature (everything else works normally).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Minted by `npm run gmail:auth` after the above are set.
GMAIL_REFRESH_TOKEN=
# The dedicated inbox plant staff email, e.g. rdchub.support@gmail.com
GMAIL_HUB_EMAIL=
# How often (ms) to check the inbox for new mail. Default 2 minutes.
EMAIL_POLL_INTERVAL_MS=120000
