# Copy this file to .env before running the server.

# SQLite for local dev/testing. When moving to the company server, point
# this at SQL Server / Postgres instead (and change the `provider` in
# prisma/schema.prisma to match) — no other code changes needed.
DATABASE_URL="file:./dev.db"

# Change this to a long random string before any real deployment.
JWT_SECRET="dev-only-change-me-before-hosting"

PORT=4000

# Where uploaded/attached files are stored. Defaults to server/uploads on
# local disk if unset. Point this at shared/network storage if you ever
# run more than one server instance.
UPLOAD_DIR=

# Comma-separated list of frontend origins allowed to call the API in dev
# (the Vite dev server). Not needed in production since the server serves
# the built client itself.
CLIENT_ORIGIN="http://localhost:5173"

# Email intake (Gmail API) — see README.md's "Email intake (Gmail)" section
# for one-time setup (two options: Workspace service account, or personal
# OAuth). Leave all of these blank to run without the email feature
# (everything else works normally).

# --- Option A: Workspace service account (recommended) ---
# Path to the downloaded service-account JSON key. When set (together with
# GMAIL_HUB_EMAIL below), this is used instead of the OAuth vars below, and
# also enables sending replies as the individual Hub member who wrote them
# (see README).
GMAIL_SERVICE_ACCOUNT_KEY_PATH=
# The real Workspace mailbox to read incoming plant-staff mail from. Only
# needed if GMAIL_HUB_EMAIL (below) is a Google Group/alias rather than a
# real mailbox itself — set this to whichever real mailbox that group
# forwards into. Leave blank to just use GMAIL_HUB_EMAIL directly.
GMAIL_INBOX_ACCOUNT=

# --- Option B: personal OAuth account ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Minted by `npm run gmail:auth` after the above are set.
GMAIL_REFRESH_TOKEN=

# The dedicated hub mailbox address, e.g. distribution@rdc.in — required
# either way.
GMAIL_HUB_EMAIL=
# How often (ms) to check the inbox for new mail. Default 2 minutes.
EMAIL_POLL_INTERVAL_MS=120000
