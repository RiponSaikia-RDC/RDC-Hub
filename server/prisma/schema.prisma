// RDC Hub data model.
// Dev/test DB is SQLite (file-based, zero setup). To move to the company
// server, change `provider` to "sqlserver" or "postgresql" and set
// DATABASE_URL accordingly in .env — the rest of the schema (and every
// query in the app) stays the same.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma, so Role and status are
// plain strings here, validated at the application layer (see zod schemas
// in server/src/routes and the Role/RequestStatus unions in
// client/src/types.ts). Switching to SQL Server/Postgres later, these
// could be promoted to real `enum` types if desired, but isn't required.
// Role: "ADMIN" | "MEMBER" | "PLANT_STAFF"
// RequestStatus: "OPEN" | "IN_PROGRESS" | "RESOLVED" | "CLOSED"

model Plant {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  // Optional reference fields from the company's plant master list
  // (Type/Area/Business Head/Type 2 columns) — informational only, not
  // used by any routing logic.
  type          String? // "Commercial" | "Captive"
  area          String? // region/city grouping, e.g. "Gujarat", "Bangalore"
  businessHead  String?
  segment       String? // spreadsheet's "Type 2" column, e.g. "Major", "Single/Double", "Captive"
  createdAt DateTime @default(now())

  users    User[]
  requests ServiceRequest[]
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  username     String   @unique
  // Null until the user activates their account. Bulk-imported users are
  // created with no password; they set one themselves via a one-time OTP
  // (see otpCode/otpExpiresAt) on the Activate Account page.
  passwordHash String?
  role         String   @default("PLANT_STAFF")
  active       Boolean  @default(true)
  // False for a bulk-imported user until they've completed OTP activation.
  // Admin-created (single-add) users are activated immediately.
  activated    Boolean  @default(true)
  // Hashed OTP (never stored in plaintext) + its expiry. Set whenever a
  // user is bulk-imported or an admin triggers "reset via OTP".
  otpCode      String?
  otpExpiresAt DateTime?
  plantId      Int?
  createdAt    DateTime @default(now())

  plant                Plant?               @relation(fields: [plantId], references: [id])
  queryTypeAssignments QueryTypeAssignment[]
  requestsSubmitted    ServiceRequest[]      @relation("Requester")
  requestsAssigned     ServiceRequest[]      @relation("Assignee")
  comments             Comment[]
  attachments          Attachment[]
  faqEntries           FaqEntry[]
}

model QueryType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  // Comma-separated keywords matched (case-insensitive, substring) against
  // the subject+body of inbound emails to auto-route them to this query
  // type. See server/src/lib/emailRouter.ts.
  keywords    String?
  // At most one QueryType should have this true — it's the fallback query
  // type for inbound emails that match no keywords. Enforced in
  // server/src/routes/queryTypes.ts (setting one unsets the others).
  isEmailDefault Boolean @default(false)
  createdAt   DateTime @default(now())

  assignments QueryTypeAssignment[]
  requests    ServiceRequest[]
  faqEntries  FaqEntry[]
}

model QueryTypeAssignment {
  id          Int      @id @default(autoincrement())
  userId      Int
  queryTypeId Int
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  queryType QueryType @relation(fields: [queryTypeId], references: [id], onDelete: Cascade)

  @@unique([userId, queryTypeId])
}

model ServiceRequest {
  id            Int           @id @default(autoincrement())
  ticketNumber  String        @unique
  subject       String
  // Plain-text body — always populated. Used for search, list previews,
  // keyword routing, and as the render fallback when bodyHtml is null.
  body          String
  // Sanitised, curated rich-text version of an inbound email body (bold,
  // colours, lists, tables, links; images/scripts/signatures/quoted history
  // stripped). Null for WEB requests and for plain-text-only inbound mail.
  // See server/src/lib/emailHtml.ts.
  bodyHtml      String?
  status        String        @default("OPEN")
  queryTypeId   Int
  plantId       Int
  requesterId   Int
  assignedToId  Int?
  // "WEB" (created via the New Request form) or "EMAIL" (created by the
  // email poller from an inbound message). See server/src/lib/emailPoller.ts.
  source        String        @default("WEB")
  // Gmail's own thread id — how inbound replies get matched back to this
  // ticket. Only set for source="EMAIL".
  gmailThreadId String?       @unique
  // RFC822 Message-ID header of the most recent message in the thread
  // (inbound or outbound), used to set In-Reply-To/References when
  // replying so mail clients thread correctly.
  lastEmailMessageId String?
  // False when this ticket was created from an inbound email that matched
  // no QueryType keyword (routed to the isEmailDefault fallback and left
  // unassigned instead of auto-picked). Drives the "teach routing" panel
  // on the request detail page. Always true for source="WEB".
  keywordMatched Boolean     @default(true)
  // Raw comma-separated email addresses from the triggering inbound
  // message's To/Cc headers (source="EMAIL" only) — carried forward as Cc
  // on outbound replies so everyone on the original thread stays looped
  // in. See server/src/lib/gmail.ts.
  originalToRaw  String?
  originalCcRaw  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  resolvedAt    DateTime?

  queryType   QueryType    @relation(fields: [queryTypeId], references: [id])
  plant       Plant        @relation(fields: [plantId], references: [id])
  requester   User         @relation("Requester", fields: [requesterId], references: [id])
  assignedTo  User?        @relation("Assignee", fields: [assignedToId], references: [id])
  comments    Comment[]
  attachments Attachment[]
  faqEntries  FaqEntry[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  srId      Int
  authorId  Int
  body      String
  // Sanitised rich-text version of an inbound email reply — same treatment
  // as ServiceRequest.bodyHtml. Null for WEB comments and plain-text mail.
  bodyHtml  String?
  // "WEB" (posted from the Hub UI) or "EMAIL" (an inbound reply picked up
  // by the email poller).
  source    String   @default("WEB")
  // Gmail internal message id of the inbound message this comment came
  // from (source="EMAIL" only) — dedupe key, see ProcessedEmail.
  gmailMessageId String? @unique
  createdAt DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [srId], references: [id], onDelete: Cascade)
  author         User           @relation(fields: [authorId], references: [id])
  attachments    Attachment[]
}

model Attachment {
  id           Int      @id @default(autoincrement())
  srId         Int
  commentId    Int?
  filename     String
  storedPath   String
  mimeType     String
  size         Int
  uploadedById Int
  createdAt    DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [srId], references: [id], onDelete: Cascade)
  comment        Comment?       @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedBy     User           @relation(fields: [uploadedById], references: [id])
}

model FaqEntry {
  id          Int      @id @default(autoincrement())
  question    String
  answer      String
  queryTypeId Int?
  sourceSrId  Int?
  createdById Int
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  queryType   QueryType?      @relation(fields: [queryTypeId], references: [id])
  sourceSr    ServiceRequest? @relation(fields: [sourceSrId], references: [id])
  createdBy   User            @relation(fields: [createdById], references: [id])
}

// Dedupe log for the Gmail poller: every inbound message id that has
// already been turned into a ServiceRequest or Comment, so a repeated
// poll (e.g. if marking a message read fails/races) never double-creates.
model ProcessedEmail {
  id             Int      @id @default(autoincrement())
  gmailMessageId String   @unique
  processedAt    DateTime @default(now())
}

// Single-row status table the admin UI reads to show whether email intake
// is configured and working. Always id=1, upserted every poll.
model EmailSyncStatus {
  id            Int       @id @default(1)
  lastPollAt    DateTime?
  lastSuccessAt DateTime?
  lastError     String?
}
